# Public URL used for absolute metadata URLs.
SITE_URL=https://stocks.example.com

# Password authentication (server-only).
PASSWORD=

# Kiwoom REST API credentials (server-only).
KRA_REAL_APP_KEY=
KRA_REAL_APP_SECRET=
KRA_MOCK_DOMESTIC_APP_KEY=
KRA_MOCK_DOMESTIC_APP_SECRET=
KRA_MOCK_OVERSEAS_APP_KEY=
KRA_MOCK_OVERSEAS_APP_SECRET=

# 자동매도 실행 모드: off(기본), shadow(신호만 기록), mock(모의투자 주문).
# 실투자 실행 모드는 의도적으로 지원하지 않습니다.
STRATEGY_ENGINE_MODE=off

# Telegram notifications (server-only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
